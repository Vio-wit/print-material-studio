{
  "name": "print-material-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:api": ".\\.venv\\Scripts\\python.exe -m uvicorn api.main:app --reload --port 8000",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:api\"",
